# DATABASE CONNECTION STRING CHO NEON POSTGRESQL
# Lấy chuỗi này từ Neon Console (https://console.neon.tech):
# Chọn Project -> Connection Details -> sao chép connection string
# Tạo 1 file tên là .env (cùng thư mục với server.js) và dán nội dung sau vào:

DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-YOUR-ENDPOINT.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
